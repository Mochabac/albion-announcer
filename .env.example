# Copy this file to .env and fill in the token.

# https://discord.com/developers/applications → your application → Bot → Reset Token
DISCORD_TOKEN=paste-your-bot-token-here

# Language a server starts with, until an admin changes it with /config (en or es).
DEFAULT_LANGUAGE=en

# Optional. Relative paths are resolved against this folder.
# ACTIVITIES_FILE=activities.toml
# DATABASE_FILE=data/announcer.db
# LOG_LEVEL=INFO
